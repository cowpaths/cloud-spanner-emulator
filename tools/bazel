#!/bin/bash
# Bazel wrapper script (tools/bazel).
# Bazel automatically uses this instead of the real binary when present.
# The real bazel path is provided in the BAZEL_REAL environment variable.
#
# On macOS 15+, Bazel 6.x's wrapped_clang is missing LC_UUID which causes
# dyld to reject it. This wrapper fixes that before delegating to real bazel.
#
# Also on macOS with Xcode 16+, every compile action implicitly depends on
# <sdkroot>/SDKSettings.json (used by clang for API availability checks),
# but cc_autoconf only lists SDK subdirectories (usr/include, Frameworks,
# etc.) as builtin include directories, not the SDK root itself. That makes
# Bazel's absolute-path-leak check reject the SDKSettings.json dependency
# with "absolute path inclusion(s) found". This wrapper patches the
# generated cc_toolchain's cxx_builtin_include_directories to add the SDK
# root(s) it already references as subdirectories.
#
# Which of possibly several local_config_cc-like repos (plain
# "local_config_cc", the bzlmod-mapped "rules_cc~~cc_configure_extension~
# local_config_cc", etc.) actually gets fetched depends on which toolchains
# (target vs. exec platform) the build graph resolves, and on a cold
# output_base that's only fully discovered by actually compiling - a
# --nobuild analysis-only pass never triggers this error, and never
# materializes the "for tool" exec toolchain repos that only get created
# once something actually tries to build a host-tool dependency with them.
# So for a build/test/run/coverage command, prime with a real
# `--keep_going` run of the SAME targets first, patching and retrying
# (bounded) until that stops hitting this error, before running the actual
# command - which then finds everything already fixed (and, incidentally,
# already built, so it's fast).

set -uo pipefail

fix_cc_binaries() {
  local output_base="$1"
  local cc_dir="${output_base}/external/local_config_cc"
  local install_dir="$(dirname "${output_base}")/install"
  local needs_fix=false

  # Check all three binaries for missing LC_UUID.
  for bin in wrapped_clang wrapped_clang_pp libtool_check_unique; do
    if [[ -f "${cc_dir}/${bin}" ]] && ! otool -l "${cc_dir}/${bin}" 2>/dev/null | grep -q LC_UUID; then
      needs_fix=true
      break
    fi
  done

  if ! "${needs_fix}"; then
    return
  fi

  local src="$(find "${install_dir}" -path "*/tools/osx/crosstool/wrapped_clang.cc" -maxdepth 8 2>/dev/null | head -1)"
  if [[ -z "${src}" ]]; then
    return
  fi

  local libtool_src="$(echo "${src}" | sed 's|osx/crosstool/wrapped_clang.cc|objc/libtool_check_unique.cc|')"

  for name in wrapped_clang wrapped_clang_pp; do
    if [[ -f "${cc_dir}/${name}" ]] && ! otool -l "${cc_dir}/${name}" 2>/dev/null | grep -q LC_UUID; then
      clang++ -std=c++11 -O2 -Wl,-random_uuid -o "${cc_dir}/${name}" "${src}" 2>/dev/null
    fi
  done

  if [[ -f "${cc_dir}/libtool_check_unique" && -f "${libtool_src}" ]] && \
     ! otool -l "${cc_dir}/libtool_check_unique" 2>/dev/null | grep -q LC_UUID; then
    clang++ -std=c++11 -O2 -Wl,-random_uuid -o "${cc_dir}/libtool_check_unique" "${libtool_src}" 2>/dev/null
  fi

  echo "INFO: Fixed Bazel CC toolchain LC_UUID for macOS 15+." >&2
}

patch_sdk_builtin_dirs() {
  local output_base="$1"
  local build_file

  while IFS= read -r build_file; do
    [[ -f "${build_file}" ]] || continue
    grep -q "cxx_builtin_include_directories = \[" "${build_file}" 2>/dev/null || continue
    perl -0pi -e '
      my @sdks = ();
      while (/"([^"]*?\.sdk)(?:\/[^"]*)?"/g) {
        push @sdks, $1 unless grep { $_ eq $1 } @sdks;
      }
      for my $sdk (@sdks) {
        my $q = qq("$sdk");
        if (index($_, $q) == -1) {
          s/(cxx_builtin_include_directories = \[)/$1$q,\n    /;
        }
      }
    ' "${build_file}"
  done < <(find "${output_base}/external" -maxdepth 1 -iname "*local_config_cc*" -type d 2>/dev/null | sed 's#$#/BUILD#')
}

is_darwin_sdk_absolute_path_error() {
  grep -q "absolute path inclusion(s) found" "$1" 2>/dev/null && grep -q "SDKSettings.json" "$1" 2>/dev/null
}

if [[ "$(uname)" != "Darwin" ]]; then
  exec "${BAZEL_REAL}" "$@"
fi

OUTPUT_BASE="$("${BAZEL_REAL}" info output_base 2>/dev/null || true)"
if [[ -n "${OUTPUT_BASE}" ]]; then
  fix_cc_binaries "${OUTPUT_BASE}"
  patch_sdk_builtin_dirs "${OUTPUT_BASE}"

  # Find the bazel command verb - the first argument that isn't itself a
  # startup option (e.g. `--output_base=...` can precede it). Only
  # build/test/run/coverage actually compile anything, so only those are
  # worth priming.
  command_index=0
  command=""
  for ((i = 1; i <= $#; i++)); do
    arg="${!i}"
    if [[ "${arg}" != -* ]]; then
      command="${arg}"
      command_index=${i}
      break
    fi
  done

  case "${command}" in
    build|test|run|coverage)
      if [[ $# -gt ${command_index} ]]; then
        priming_args=("${@:1:command_index-1}" "${command}" "--keep_going" "${@:command_index+1}")
        LOG="$(mktemp)"
        trap 'rm -f "${LOG}"' EXIT
        attempt=0
        max_attempts=6
        while [[ ${attempt} -lt ${max_attempts} ]]; do
          attempt=$((attempt + 1))
          set +o pipefail
          "${BAZEL_REAL}" "${priming_args[@]}" 2>&1 | tee "${LOG}"
          set -o pipefail
          if ! is_darwin_sdk_absolute_path_error "${LOG}"; then
            break
          fi
          echo "INFO: Priming pass ${attempt} hit macOS SDK absolute-path-inclusion failures; patching and repriming." >&2
          fix_cc_binaries "${OUTPUT_BASE}"
          patch_sdk_builtin_dirs "${OUTPUT_BASE}"
        done
      fi
      ;;
  esac
fi

exec "${BAZEL_REAL}" "$@"
